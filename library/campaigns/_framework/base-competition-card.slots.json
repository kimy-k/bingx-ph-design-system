    {"id": "step-1", "default": "Sign up at BingX via [REFERRAL_LINK]", "max-length": 60},
    {"id": "step-2", "default": "Start Copy Trading any verified trader", "max-length": 60},
    {"id": "step-3", "default": "Top 3 highest ROI by month-end win prizes", "max-length": 60},
    {"id": "deadline", "default": "ENDS DEC 31 · 5 DAYS LEFT", "max-length": 32, "transform": "uppercase"}
